# Supabase (client-safe publishable/anon key — RLS enforced)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# AI review on the home deck. Gemini is tried first, Groq is the fallback.
# Either one alone is enough; with neither, the panel explains what is missing.
# NOTE: VITE_* vars are inlined into the client bundle and are therefore visible
# to anyone who loads the site. Use keys you are willing to rotate.
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GROQ_API_KEY=your-groq-api-key
